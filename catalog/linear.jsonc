// Linear.
// S2 MCP-direct; the connector playbook's worked example. OAuth custody is
// operator-provisioned (ck auth + binding ticket) until the vault-driven
// connect seam ships.
{
  "schema_version": 1,
  "key": "linear",
  "name": "Linear",
  "description": "Issues, projects, cycles.",
  "reuse_path": "mcp_direct",
  "reuse_rationale": "Official hosted MCP server; tools map cleanly to grants.",
  "tier": "S2",
  "transport": {
    "kind": "mcp_remote",
    "url": "https://mcp.linear.app/mcp"
  },
  "auth": {
    "mode": "oauth",
    "oauth": {
      // Reference into the claustrum vault's reviewed OAuth-profile
      // registry: the manifest never carries endpoints, client credentials,
      // or refresh parameters; the vault owns those.
      "profile_id": "linear",
      "profile_digest": "sha256:TBD-pinned-at-first-connect",
      "requested_scopes": ["read", "write"]
    }
  },
  "credential_bindings": [
    {
      "ref_role": "access_token",
      "placement": "header",
      "key": "Authorization",
      "prefix": "Bearer ",
      "required": true
    }
  ],
  "resource_filters": {
    "required": ["workspace", "team"],
    "optional": ["project", "label", "cycle", "status"],
    "write_enabling": ["team"]
  },
  "actions_baseline": [
    { "name": "search_issues", "risk": "read" },
    { "name": "get_issue", "risk": "read" },
    {
      "name": "create_issue",
      "risk": "write",
      "reconciliation": {
        "correlation_fields": ["title", "creator", "time_window"],
        "read_back_action": "search_issues",
        "timeout_s": 120
      },
      "idempotency": "none"
    },
    {
      "name": "comment_issue",
      "risk": "write",
      "reconciliation": {
        "correlation_fields": ["issue_id", "body_hash", "time_window"],
        "read_back_action": "get_issue",
        "timeout_s": 120
      },
      "idempotency": "none"
    },
    {
      "name": "update_issue_status",
      "risk": "write",
      "reconciliation": {
        "correlation_fields": ["issue_id", "target_status"],
        "read_back_action": "get_issue",
        "timeout_s": 60
      },
      "idempotency": "natural"
    }
  ],
  "defaults": {
    "ask_first_risk": ["write", "destructive"],
    "rate_limit": { "calls_per_min": 30 }
  },
  "availability": "ga"
}
