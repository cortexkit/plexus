// Google Calendar.
// S2 MCP-direct (Google provider); declares the read-only slice only. Event
// writes (invites are external messaging) are not declared. OAuth custody is
// operator-provisioned (ck auth + binding ticket) until the vault-driven
// connect seam ships.
{
  "schema_version": 1,
  "key": "gcal",
  "name": "Google Calendar",
  "description": "Calendars, events, and free/busy availability (read-only Batch A).",
  "reuse_path": "mcp_direct",
  "reuse_rationale": "Official Google-hosted MCP surface; read tools map cleanly to grants.",
  "tier": "S2",
  "transport": {
    "kind": "mcp_remote",
    "url": "https://mcp.google.com/calendar/mcp"
  },
  "auth": {
    "mode": "oauth",
    "oauth": {
      // Reference into the claustrum vault's reviewed OAuth-profile
      // registry: the manifest never carries endpoints, client credentials,
      // or refresh parameters; the vault owns those.
      "profile_id": "google-calendar",
      "profile_digest": "sha256:TBD-pinned-at-first-connect",
      "requested_scopes": [
        "https://www.googleapis.com/auth/calendar.readonly"
      ]
    }
  },
  "credential_bindings": [
    {
      "ref_role": "access_token",
      "placement": "header",
      "key": "Authorization",
      "prefix": "Bearer ",
      "required": true
    }
  ],
  "resource_filters": {
    "required": ["calendar_allowlist"],
    "optional": ["time_window", "attendee_domain"],
    "write_enabling": []
  },
  "actions_baseline": [
    { "name": "list_calendars", "risk": "read" },
    { "name": "list_events", "risk": "read" },
    { "name": "get_availability", "risk": "read" }
  ],
  "defaults": {
    "ask_first_risk": ["write", "destructive"],
    "rate_limit": { "calls_per_min": 30 }
  },
  "availability": "ga"
}
