// Gmail send-only. Structured addresses are governed before the MIME
// composer builds raw RFC 822 bytes; callers cannot supply raw messages.
{
  "schema_version": 1,
  "key": "gmail",
  "name": "Gmail",
  "description": "Send plain-text email from the operator's Gmail mailbox.",
  "reuse_path": "openapi_shim",
  "reuse_rationale": "Official Gmail REST send endpoint with vault-held OAuth.",
  "tier": "S3",
  "transport": { "kind": "rest_api", "url": "https://gmail.googleapis.com" },
  "auth": { "mode": "oauth", "oauth": { "profile_id": "gmail", "profile_digest": "", "requested_scopes": [] } },
  "credential_bindings": [
    { "ref_role": "access_token", "placement": "header", "key": "Authorization", "prefix": "Bearer ", "required": true }
  ],
  "resource_filters": { "required": [], "optional": [], "write_enabling": ["to", "cc", "bcc"] },
  "actions_baseline": [
    {
      "name": "gmail.send",
      "risk": "write",
      "recipients": ["/to", "/cc", "/bcc"],
      "http": {
        "method": "POST",
        "path": "/gmail/v1/users/me/messages/send",
        "args_schema": {
          "type": "object",
          "properties": {
            "to": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
            "cc": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
            "bcc": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
            "subject": { "type": "string", "maxLength": 200 },
            "body": { "type": "string", "maxLength": 200000 }
          },
          "required": ["to", "cc", "bcc", "subject", "body"],
          "additionalProperties": false
        }
      }
    }
  ],
  "defaults": { "ask_first_risk": ["write", "destructive"] },
  "availability": "ga"
}
