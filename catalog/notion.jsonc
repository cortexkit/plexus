// Notion.
// S3 floor provider: writes require a decision plane and are refused while no
// production plane is wired. OAuth custody is operator-provisioned (ck auth + binding
// ticket) until the vault-driven connect seam ships.
{
  "schema_version": 1,
  "key": "notion",
  "name": "Notion",
  "description": "Workspace pages, databases, and blocks.",
  "reuse_path": "mcp_direct",
  "reuse_rationale": "Official hosted MCP server; tools map cleanly to grants.",
  "tier": "S3",
  "transport": {
    "kind": "mcp_remote",
    "url": "https://mcp.notion.com/mcp"
  },
  "auth": {
    "mode": "oauth",
    "oauth": {
      // Reference into the claustrum vault's reviewed OAuth-profile
      // registry: the manifest never carries endpoints, client credentials,
      // or refresh parameters; the vault owns those.
      "profile_id": "notion",
      // Kept only so older Plexus builds parse this file; nothing reads these fields.
      "profile_digest": "",
      "requested_scopes": []
    }
  },
  "credential_bindings": [
    {
      "ref_role": "access_token",
      "placement": "header",
      "key": "Authorization",
      "prefix": "Bearer ",
      "required": true
    }
  ],
  "resource_filters": {
    "required": [],
    "optional": [],
    "write_enabling": []
  },
  "actions_baseline": [
    { "name": "search", "risk": "read" },
    { "name": "query_database", "risk": "read" },
    { "name": "read_page", "risk": "read" },
    {
      "name": "create_page",
      "risk": "write"
    },
    {
      "name": "append_block",
      "risk": "write"
    }
  ],
  "defaults": {
    "ask_first_risk": ["write", "destructive"],
    "rate_limit": { "calls_per_min": 30 }
  },
  "availability": "ga"
}
