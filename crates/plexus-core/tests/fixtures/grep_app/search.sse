data: {"result":{"content":[{"type":"text","text":"Repository: rust-lang/rust\nPath: library/std/src/collections/hash/set.rs\nURL: https://github.com/rust-lang/rust/blob/main/library/std/src/collections/hash/set.rs\nLicense: Apache-2.0\n\nSnippets:\n--- Snippet 1 (Line 164) ---\n    /// assert!(set.capacity() >= 10);\n    /// ```\n    #[inline]\n    #[must_use]\n    #[stable(feature = \"rust1\", since = \"1.0.0\")]\n    pub fn with_capacity(capacity: usize) -> HashSet<T, RandomState> {\n        HashSet::with_capacity_and_hasher(capacity, Default::default())\n    }\n}\n\nimpl<T, A: Allocator> HashSet<T, RandomState, A> {\n\n\n--- Snippet 2 (Line 208) ---\n    /// let set: HashSet<i32> = HashSet::with_capacity_in(10, Global);\n    /// ```\n    #[inline]\n    #[must_use]\n    #[unstable(feature = \"allocator_api\", issue = \"32838\")]\n    pub fn with_capacity_in(capacity: usize, alloc: A) -> HashSet<T, RandomState, A> {\n        HashSet::with_capacity_and_hasher_in(capacity, Default::default(), alloc)\n    }\n}\n"},{"type":"text","text":"Repository: rust-lang/rust\nPath: library/std/src/collections/hash/map.rs\nURL: https://github.com/rust-lang/rust/blob/main/library/std/src/collections/hash/map.rs\nLicense: Apache-2.0\n\nSnippets:\n--- Snippet 1 (Line 283) ---\n    /// let mut map: HashMap<&str, i32> = HashMap::with_capacity(10);\n    /// ```\n    #[inline]\n    #[must_use]\n    #[stable(feature = \"rust1\", since = \"1.0.0\")]\n    pub fn with_capacity(capacity: usize) -> HashMap<K, V, RandomState> {\n        HashMap::with_capacity_and_hasher(capacity, Default::default())\n    }\n}\n\nimpl<K, V, A: Allocator> HashMap<K, V, RandomState, A> {\n\n\n--- Snippet 2 (Line 329) ---\n    /// let map: HashMap<i32, i32> = HashMap::with_capacity_in(10, Global);\n    /// ```\n    #[inline]\n    #[must_use]\n    #[unstable(feature = \"allocator_api\", issue = \"32838\")]\n    pub fn with_capacity_in(capacity: usize, alloc: A) -> Self {\n        HashMap::with_capacity_and_hasher_in(capacity, Default::default(), alloc)\n    }\n}\n"},{"type":"text","text":"Repository: rust-lang/rust\nPath: compiler/rustc_data_structures/src/unord.rs\nURL: https://github.com/rust-lang/rust/blob/main/compiler/rustc_data_structures/src/unord.rs\nLicense: Apache-2.0\n\nSnippets:\n--- Snippet 1 (Line 269) ---\n    pub fn new() -> Self {\n        Self { inner: Default::default() }\n    }\n\n    #[inline]\n    pub fn with_capacity(capacity: usize) -> Self {\n        Self { inner: FxHashSet::with_capacity_and_hasher(capacity, Default::default()) }\n    }\n\n    #[inline]\n    pub fn len(&self) -> usize {\n\n\n--- Snippet 2 (Line 484) ---\n    }\n}\n\nimpl<K: Eq + Hash, V> UnordMap<K, V> {\n    #[inline]\n    pub fn with_capacity(capacity: usize) -> Self {\n        Self { inner: FxHashMap::with_capacity_and_hasher(capacity, Default::default()) }\n    }\n\n"},{"type":"text","text":"Repository: rust-lang/rust\nPath: src/tools/clippy/clippy_dev/src/utils.rs\nURL: https://github.com/rust-lang/rust/blob/main/src/tools/clippy/clippy_dev/src/utils.rs\nLicense: Apache-2.0\n\nSnippets:\n--- Snippet 1 (Line 704) ---\n\n/// A string used as a temporary buffer used to avoid allocating for short lived strings.\npub struct StrBuf(String);\nimpl StrBuf {\n    /// Creates a new buffer with the specified initial capacity.\n    pub fn with_capacity(cap: usize) -> Self {\n        Self(String::with_capacity(cap))\n    }\n\n    /// Allocates the result of formatting the given value onto the arena.\n    pub fn alloc_display<'cx>(&mut self, arena: &'cx DroplessArena, value: impl Display) -> &'cx str {\n\n\n--- Snippet 2 (Line 783) ---\n}\n\npub struct VecBuf<T>(Vec<T>);\nimpl<T> VecBuf<T> {\n    /// Creates a new buffer with the specified initial capacity.\n    pub fn with_capacity(cap: usize) -> Self {\n        Self(Vec::with_capacity(cap))\n    }\n\n"},{"type":"text","text":"Repository: rust-lang/rust-clippy\nPath: clippy_dev/src/utils.rs\nURL: https://github.com/rust-lang/rust-clippy/blob/master/clippy_dev/src/utils.rs\nLicense: Apache-2.0\n\nSnippets:\n--- Snippet 1 (Line 704) ---\n\n/// A string used as a temporary buffer used to avoid allocating for short lived strings.\npub struct StrBuf(String);\nimpl StrBuf {\n    /// Creates a new buffer with the specified initial capacity.\n    pub fn with_capacity(cap: usize) -> Self {\n        Self(String::with_capacity(cap))\n    }\n\n    /// Allocates the result of formatting the given value onto the arena.\n    pub fn alloc_display<'cx>(&mut self, arena: &'cx DroplessArena, value: impl Display) -> &'cx str {\n\n\n--- Snippet 2 (Line 783) ---\n}\n\npub struct VecBuf<T>(Vec<T>);\nimpl<T> VecBuf<T> {\n    /// Creates a new buffer with the specified initial capacity.\n    pub fn with_capacity(cap: usize) -> Self {\n        Self(Vec::with_capacity(cap))\n    }\n\n"},{"type":"text","text":"Repository: rust-lang/rust\nPath: library/alloc/src/collections/binary_heap/mod.rs\nURL: https://github.com/rust-lang/rust/blob/main/library/alloc/src/collections/binary_heap/mod.rs\nLicense: Apache-2.0\n\nSnippets:\n--- Snippet 1 (Line 528) ---\n    /// let mut heap = BinaryHeap::with_capacity(10);\n    /// heap.push(4);\n    /// ```\n    #[stable(feature = \"rust1\", since = \"1.0.0\")]\n    #[must_use]\n    pub fn with_capacity(capacity: usize) -> BinaryHeap<T> {\n        BinaryHeap { data: Vec::with_capacity(capacity) }\n    }\n}\n\nimpl<T, A: Allocator> BinaryHeap<T, A> {\n\n\n--- Snippet 2 (Line 574) ---\n    ///\n    /// let heap: BinaryHeap<i32, System> = BinaryHeap::with_capacity_in(10, System);\n    /// ```\n    #[unstable(feature = \"allocator_api\", issue = \"32838\")]\n    #[must_use]\n    pub fn with_capacity_in(capacity: usize, alloc: A) -> BinaryHeap<T, A> {\n        BinaryHeap { data: Vec::with_capacity_in(capacity, alloc) }\n    }\n\n"},{"type":"text","text":"Repository: rust-lang/rust\nPath: tests/codegen-llvm/vec-with-capacity.rs\nURL: https://github.com/rust-lang/rust/blob/main/tests/codegen-llvm/vec-with-capacity.rs\nLicense: Apache-2.0\n\nSnippets:\n--- Snippet 1 (Line 5) ---\n#![crate_type = \"lib\"]\n#![feature(try_with_capacity)]\n\n// CHECK-LABEL: @with_capacity_does_not_grow1\n#[no_mangle]\npub fn with_capacity_does_not_grow1() -> Vec<u32> {\n    let v = Vec::with_capacity(1234);\n    // CHECK: call {{.*}}__rust_alloc(\n    // CHECK-NOT: call {{.*}}__rust_realloc\n    // CHECK-NOT: call {{.*}}capacity_overflow\n    // CHECK-NOT: call {{.*}}finish_grow\n"},{"type":"text","text":"Repository: rust-lang/rust\nPath: src/tools/rust-analyzer/crates/parser/src/input.rs\nURL: https://github.com/rust-lang/rust/blob/main/src/tools/rust-analyzer/crates/parser/src/input.rs\nLicense: Apache-2.0\n\nSnippets:\n--- Snippet 1 (Line 22) ---\n}\n\n/// `pub` impl used by callers to create `Tokens`.\nimpl Input {\n    #[inline]\n    pub fn with_capacity(capacity: usize) -> Self {\n        Self {\n            kind: Vec::with_capacity(capacity),\n            joint: Vec::with_capacity(capacity.div_ceil(bits::BITS as usize)),\n            contextual_kind: Vec::with_capacity(capacity),\n            edition: Vec::with_capacity(capacity),\n"},{"type":"text","text":"Repository: rust-lang/rust\nPath: library/std/src/sys/process/unix/common/cstring_array.rs\nURL: https://github.com/rust-lang/rust/blob/main/library/std/src/sys/process/unix/common/cstring_array.rs\nLicense: Apache-2.0\n\nSnippets:\n--- Snippet 1 (Line 12) ---\n}\n\nimpl CStringArray {\n    /// Creates a new `CStringArray` with enough capacity to hold `capacity`\n    /// strings.\n    pub fn with_capacity(capacity: usize) -> Self {\n        let mut result = CStringArray { ptrs: Vec::with_capacity(capacity + 1) };\n        result.ptrs.push(ptr::null());\n        result\n    }\n\n"},{"type":"text","text":"Repository: rust-lang/rust\nPath: compiler/rustc_data_structures/src/sso/set.rs\nURL: https://github.com/rust-lang/rust/blob/main/compiler/rustc_data_structures/src/sso/set.rs\nLicense: Apache-2.0\n\nSnippets:\n--- Snippet 1 (Line 41) ---\n        Self { map: SsoHashMap::new() }\n    }\n\n    /// Creates an empty `SsoHashSet` with the specified capacity.\n    #[inline]\n    pub fn with_capacity(cap: usize) -> Self {\n        Self { map: SsoHashMap::with_capacity(cap) }\n    }\n\n    /// Clears the set, removing all values.\n    #[inline]\n"}]},"jsonrpc":"2.0","id":2}

