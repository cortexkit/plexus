// Linear is required by the operator-path ceremony exercised in this file.
{
  "schema_version": 1,
  "key": "linear",
  "name": "Linear",
  "description": "Issues, projects, cycles.",
  "reuse_path": "mcp_direct",
  "reuse_rationale": "Official hosted MCP server; tools map cleanly to grants.",
  "tier": "S2",
  "transport": {
    "kind": "mcp_remote",
    "url": "https://mcp.linear.app/mcp"
  },
  "auth": {
    "mode": "oauth",
    "oauth": {
      "profile_id": "linear",
      "profile_digest": "",
      "requested_scopes": []
    }
  },
  "credential_bindings": [
    {
      "ref_role": "access_token",
      "placement": "header",
      "key": "Authorization",
      "prefix": "Bearer ",
      "required": true
    }
  ],
  // Synthetic team selector for the operator-path configure test, not a vendor schema.
  "resource_filters": {"required":[], "optional":["team"], "write_enabling":["team"]},
  "actions_baseline": [
    { "name": "search_issues", "risk": "read" },
    { "name": "get_issue", "risk": "read" },
    {
      "name": "create_issue",
      "risk": "write",
      "input_schema": {"type":"object", "properties":{
        "team":{"type":"string"}, "workspace":{"type":"string"}, "title":{"type":"string"}
      }}
    },
    {
      "name": "comment_issue",
      "risk": "write"
    },
    {
      "name": "update_issue_status",
      "risk": "write"
    }
  ],
  "defaults": {
    "ask_first_risk": ["write", "destructive"],
    "rate_limit": { "calls_per_min": 30 }
  },
  "availability": "ga"
}
