{
  "scope": {
    "kind": "head",
    "agent_id": "agent-x"
  },
  "call": {
    "name": "github_read",
    "arguments": {
      "action": "github.repo.get",
      "repository": "o/x",
      "args": {
        "path": "pulls",
        "query": {
          "state": "open",
          "per_page": "2"
        }
      }
    }
  }
}
