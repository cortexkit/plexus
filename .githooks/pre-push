#!/bin/bash
# Refuse to push a commit to main unless CI has already gone green on that exact
# sha.
#
# Local tests cannot guarantee that CI will pass on its own runner and Cargo
# cache. Requiring a successful CI run for the exact commit prevents a direct
# push from leaving main on a failure the local gate could not observe.
#
# The repository's main ruleset also requires the test job, but it lets
# administrators bypass it, so this hook is still the gate for a maintainer's
# own pushes.
#
# scripts/train.sh runs the gated landing flow: it pushes to train/<name>,
# watches CI to completion on that sha, and fast-forwards main only on green. By
# then the sha already has a successful run, so the train passes this hook
# untouched. A direct push of a fresh commit has no run at all and is refused,
# which is the entire point: the train becomes the only way onto main rather than
# the preferred way.
#
# Deliberate bypass remains `git push --no-verify`, which is an explicit act
# rather than an accident.
# Installation is opt-in: run scripts/install-hooks.sh in each new clone.
# The train independently checks CI even when this optional hook is not installed.

set -eu
if [ -z "${BASH_VERSION:-}" ]; then exec /bin/bash "$0" "$@"; fi

# Check identity for every ref, including train/* branches, tags and deletions.
# If a private repository is renamed and a public repository takes its old name,
# green CI from the old history must not authorize a push to the new repository.
repo_root="$(git rev-parse --show-toplevel)"
. "$repo_root/scripts/lib/repository-identity.sh"
if ! . "$repo_root/scripts/lib/operator-gh.sh"; then
    echo "repository guard: refusing — gh is required to resolve origin's repository ID; nothing was verified." >&2
    exit 1
fi
repo_slug="$(require_github_repository "$repo_root" "$OPERATOR_GH" "${2:-}")" || exit 1

remote_ref_is_main=0
sha=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
    # A deletion pushes the all-zero sha and has nothing to verify.
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac
    # Local parity is required for every pushed commit, including train refs
    # and annotated tags. The receipt checker peels tags to their commit.
    bash "$repo_root/scripts/prepush.sh" --require-pass "$local_sha" || exit 1
    [ "$remote_ref" = "refs/heads/main" ] || continue
    remote_ref_is_main=1
    sha="$local_sha"
done

[ "$remote_ref_is_main" -eq 1 ] || exit 0

if ! command -v "$OPERATOR_GH" >/dev/null 2>&1; then
    echo "pre-push: refusing — gh is required to check CI on $sha and is not on PATH." >&2
    echo "  This hook cannot tell a green commit from a red one without it, and" >&2
    echo "  'could not check' must not read as 'checked and fine'." >&2
    echo "  Land through scripts/train.sh, or push with --no-verify deliberately." >&2
    exit 1
fi

# Group by check NAME and take the LATEST run for each. A sha can carry both a
# failure and a later success when a transient red is re-run, and the retry is
# the authoritative result — my first version refused on any non-success and
# would have blocked a commit that CI had genuinely passed on its second run.
# This is the graded-sample shape: the newest sample per name decides, and older
# samples are history rather than verdicts.
#
# Socket Security is excluded: it is a third-party app, not our gate, and its
# verdict is not what "main is green" means here.
if ! checks="$("$OPERATOR_GH" api "repos/$repo_slug/commits/$sha/check-runs" \
        --hostname github.com \
        --jq '[.check_runs[] | select(.app.slug == "github-actions")]
              | group_by(.name)
              | map(sort_by(.started_at) | last)
              | .[] | "\(.name)\t\(.conclusion // "pending")"' 2>/dev/null)"; then
    echo "pre-push: refusing — could not read CI results for $sha." >&2
    echo "  Offline, unauthenticated, or the API refused. This is a check that" >&2
    echo "  DID NOT RUN, not a clean result." >&2
    echo "  Land through scripts/train.sh, or push with --no-verify deliberately." >&2
    exit 1
fi

tab="$(printf '\t')"
tested=0
verdicts=""
while IFS="$tab" read -r check_name conclusion; do
    [ "$check_name:$conclusion" = "Test (ubuntu):success" ] && tested=1
done <<EOF
$checks
EOF
while IFS="$tab" read -r check_name conclusion; do
    [ -n "$check_name" ] || continue
    verdicts="${verdicts:+$verdicts,}${conclusion:-pending}"
done <<EOF
$checks
EOF

# A third-party green check cannot substitute for this repository's test job.
if [ "$tested" -ne 1 ]; then
    echo "pre-push: refusing — Test (ubuntu) did not succeed; no check is green enough to land $sha (not every check is green)." >&2
    exit 1
fi

if [ -z "$checks" ]; then
    echo "pre-push: refusing — no CI run exists for $sha." >&2
    echo "  A commit reaches main only after CI has gone green on its exact sha." >&2
    echo "  Land it with: scripts/train.sh <name>" >&2
    exit 1
fi

# Every check's latest verdict must be success. One non-success is a refusal,
# and the message names the whole set so the reader sees which check dissented.
case ",$verdicts," in
    *,success,*)
        case "$verdicts" in
            *failure*|*timed_out*|*cancelled*|*action_required*|*pending*|*neutral*|*skipped*|*stale*)
                echo "pre-push: refusing — not every check is green on $sha (latest per check: $verdicts)." >&2
                echo "  Land it with: scripts/train.sh <name>" >&2
                exit 1
                ;;
        esac
        exit 0
        ;;
esac

# Reached when no check reported success at all: every latest verdict is pending,
# neutral, skipped or failed. A run in progress is not a green run.
echo "pre-push: refusing — no check is green on $sha (latest per check: $verdicts)." >&2
echo "  A run in progress is not a green run. Wait for it, or land it with:" >&2
echo "    scripts/train.sh <name>" >&2
exit 1
